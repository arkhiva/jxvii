<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arkanbank.Controls.Cells.InventoryCell">

    <Border
        Margin="0,0,0,18"
        Padding="18"
        StrokeThickness="0"
        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
        StrokeShape="RoundRectangle 18">

        <Grid ColumnDefinitions="60,*,Auto">

            <!-- Ícone -->

            <Border
                WidthRequest="60"
                HeightRequest="60"
                BackgroundColor="{Binding Source={x:Reference Root}, Path=IconBackground}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16">

                <Grid>

                    <Label
                        x:Name="emoji"
                        FontSize="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                    <Label
                        x:Name="icon"
                        FontFamily="IconsSolid"
                        FontSize="28"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="{StaticResource Primary}" />
                </Grid>
            </Border>

            <!-- Conteúdo -->

            <VerticalStackLayout
                Grid.Column="1"
                Margin="10,0">

                <Border
                    x:Name="categoryBorder"
                    HorizontalOptions="Start"
                    Padding="8,3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10">

                    <Label
                        x:Name="category"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="White" />
                </Border>

                <Label
                    Margin="0,4,0,0"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="{Binding Source={x:Reference Root}, Path=Name}" />

                <Label
                    FontSize="11"
                    Text="{Binding Source={x:Reference Root}, Path=Description}"
                    TextColor="{AppThemeBinding Light=#666,Dark=#AAA}" />
            </VerticalStackLayout>

            <!-- Botão -->

            <VerticalStackLayout
                x:Name="actionContainer"
                Grid.Column="2"
                VerticalOptions="Center">

                <Button
                    Text="Abrir"
                    Clicked="Button_Clicked" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>