<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arkanbank.Controls.Cells.ExtractCell">

    <Border
        Margin="20,6"
        Padding="18"
        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
        StrokeShape="RoundRectangle 18">

        <Grid
            ColumnDefinitions="30,*,Auto"
            ColumnSpacing="15"
            RowDefinitions="Auto,Auto">

            <!-- Ícone -->

            <Label
                x:Name="icon"
                Grid.RowSpan="2"
                Grid.Column="0"
                FontFamily="IconsSolid"
                FontSize="22"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center" />

            <!-- Título -->

            <Label
                x:Name="title"
                Grid.Row="0"
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="17"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

            <!-- Data -->

            <Label
                x:Name="date"
                Grid.Row="1"
                Grid.Column="1"
                FontSize="13"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <!-- Valor -->

            <Label
                x:Name="amount"
                Grid.RowSpan="2"
                Grid.Column="2"
                FontAttributes="Bold"
                FontSize="22"
                HorizontalTextAlignment="End"
                VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>