<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cells="clr-namespace:arkanbank.Controls.Cells"
    x:Class="arkanbank.Views.StorePage"
    Title="Loja ARKAN">

    <Grid RowDefinitions="Auto,*">

        <!-- =============================================== -->
        <!-- Saldo -->
        <!-- =============================================== -->

        <Border
            Grid.Row="0"
            Margin="20,0,20,15"
            Padding="25"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
            StrokeShape="RoundRectangle 22">

            <VerticalStackLayout>
                <Label
                    FontSize="15"
                    Text="Saldo disponível"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    VerticalOptions="Center">

                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontSize="40"
                        VerticalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    Text="N$ "
                                    FontSize="40" />
                                <Span
                                    x:Name="BalanceLabel"
                                    FontSize="40" />
                                <Span
                                    x:Name="BalanceCentLabel"
                                    FontSize="28" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button
                        x:Name="VisibilityButton"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        BackgroundColor="Transparent"
                        Clicked="OnVisibility_Clicked"
                        FontFamily="IconsSolid"
                        FontSize="18"
                        Text="&#xf06e;"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </Grid>

                <Label
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                    Text="Use seus Nexos para desbloquear experiências, dicas e funcionalidades exclusivas." />
            </VerticalStackLayout>
        </Border>

        <!-- =============================================== -->
        <!-- Produtos -->
        <!-- =============================================== -->

        <CollectionView
            Grid.Row="1"
            Margin="20,0"
            ItemsSource="{Binding Products}"
            VerticalScrollBarVisibility="Never"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <cells:StoreCell
                        Id="{Binding Id}"
                        Name="{Binding Name}"
                        Description="{Binding Description}"
                        Category="{Binding Category}"
                        Emoji="{Binding Emoji}"
                        Icon="{Binding Icon}"
                        IconBackground="{Binding IconBackground}"
                        Price="{Binding Price}"
                        Clicked="StoreCell_Clicked" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>