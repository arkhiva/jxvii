<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="arkanbank.Views.StorePage"
    Title="Loja ARKAN">

    <Grid RowDefinitions="Auto,*">

        <!-- =============================================== -->
        <!-- Cabeçalho -->
        <!-- =============================================== -->

        <!-- =============================================== -->
        <!-- Saldo -->
        <!-- =============================================== -->

        <Border
    Grid.Row="0"
    Margin="20,0,20,25"
    Padding="25"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
    StrokeShape="RoundRectangle 22">

            <VerticalStackLayout>

                <Label
            FontSize="15"
            Text="Saldo disponível"
            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <Grid
            ColumnDefinitions="*,Auto"
            VerticalOptions="Center">

                    <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="40"
                VerticalTextAlignment="Center"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}">

                        <Label.FormattedText>
                            <FormattedString>

                                <Span
                            Text="N$ "
                            FontSize="40" />

                                <Span
                            x:Name="BalanceLabel"
                            FontSize="40" />

                                <Span
                            x:Name="BalanceCentLabel"
                            FontSize="28" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button
                x:Name="VisibilityButton"
                Grid.Column="1"
                Margin="10,0,0,0"
                BackgroundColor="Transparent"
                Clicked="OnVisibility_Clicked"
                FontFamily="IconsSolid"
                FontSize="18"
                Text="&#xf06e;"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </Grid>

                <Label
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                    Text="Use seus Nexos para desbloquear experiências, dicas e funcionalidades exclusivas." />
            </VerticalStackLayout>
        </Border>

        <!-- =============================================== -->
        <!-- Produtos -->
        <!-- =============================================== -->

        <CollectionView
            Grid.Row="1"
            Margin="20,0"
            ItemsSource="{Binding Products}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,18"
                        Padding="18"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 18">

                        <Grid
                            ColumnDefinitions="60,*,Auto"
                            RowDefinitions="Auto,Auto,Auto">

                            <!-- Ícone -->

                            <Border
                                WidthRequest="60"
                                HeightRequest="60"
                                BackgroundColor="{Binding IconBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">

                                <Grid>

                                    <Label
                                        IsVisible="{Binding HasEmoji}"
                                        Text="{Binding Emoji}"
                                        FontSize="32"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                    <Label
                                        IsVisible="{Binding HasIcon}"
                                        FontFamily="{Binding IconFont}"
                                        Text="{Binding Icon}"
                                        FontSize="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Grid>
                            </Border>

                            <!-- Conteúdo -->

                            <VerticalStackLayout
                                Grid.Column="1"
                                Margin="10,0">

                                <!-- Categoria -->

                                <Border
                                    Padding="8,3"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding CategoryColor}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">

                                    <Label
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Text="{Binding CategoryName}"
                                        TextColor="White" />
                                </Border>

                                <Label
                                    Margin="0,6,0,0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Text="{Binding Name}" />

                                <Label
                                    FontSize="11"
                                    TextColor="{AppThemeBinding Light=#666,Dark=#AAA}"
                                    Text="{Binding Description}" />

                                <HorizontalStackLayout
                                    Margin="0,10,0,0"
                                    Spacing="20">

                                    <HorizontalStackLayout>

                                        <Label
                                            FontFamily="IconsSolid"
                                            FontSize="12"
                                            Text="&#xf3d1;"
                                            VerticalTextAlignment="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                                        <Label
                                            Margin="4,0,0,0"
                                            FontAttributes="Bold"
                                            FontSize="10"
                                            VerticalTextAlignment="Center"
                                            Text="{Binding PriceLabel}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout>

                                        <Label
                                            FontFamily="IconsSolid"
                                            FontSize="12"
                                            VerticalTextAlignment="Center"
                                            Text="&#xf0c0;"
                                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                                        <Label
                                            Margin="4,0,0,0"
                                            FontSize="10"
                                            VerticalTextAlignment="Center"
                                            Text="{Binding QuantityLabel}" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Botão -->

                            <VerticalStackLayout
                                Grid.Column="2"
                                VerticalOptions="Center">

                                <Button
                                    Text="{Binding ButtonText}"
                                    IsEnabled="{Binding CanBuy}"
                                    Command="{Binding BuyCommand}"
                                    TextColor="White"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    FontAttributes="Bold" />

                                <Label
                                    HorizontalTextAlignment="Center"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                    IsVisible="{Binding RequireApproval}"
                                    Text="*Requer aprovação" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>